DUSA_prop<-ggplot(data = DUSA, aes(x = Annee, y = prop_HY)) +
geom_col(fill= "darkorange") +
scale_x_continuous(breaks = seq(2007, 2022, by = 5), limits = c(2006,2025)) +
xlab("Année") +
ylab("Proportion HY") +
geom_text(aes(label = nb_tot), vjust = -0.5, size = 2)+
